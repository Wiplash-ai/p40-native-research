{
  "image": "p40-marathon-runner:0.1.0",
  "command": [
    "/bin/sh",
    "-lc",
    "cd /workspace/p40-native-research && python3 scripts/codex_marathon.py enqueue"
  ],
  "working_dir": "/workspace/p40-native-research",
  "timeout_seconds": 10800,
  "dispatch_grace_minutes": 210,
  "user": "1000:1000",
  "environment": {
    "HOME": "/workspace/home",
    "P40_MARATHON_REPOSITORY": "/workspace/p40-native-research",
    "P40_MARATHON_CONTAINER": "1",
    "TZ": "America/Chicago"
  },
  "mounts": [
    {
      "source": "/home/jordanculver/Laboratory/p40-native-research",
      "target": "/workspace/p40-native-research",
      "read_only": false
    }
  ],
  "remove_container": false,
  "labels": {
    "wiplash.product": "p40-native-research",
    "wiplash.safety": "task-gated-no-gpu-before-T00-T01-T03"
  }
}
