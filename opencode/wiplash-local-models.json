{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "opencode-better-hashline@0.9.0",
      {
        "enforce": true,
        "toolSurface": "hashline",
        "lspDiagnostics": false
      }
    ]
  ],
  "provider": {
    "wiplash-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Wiplash P40 Auto (SSH tunnel)",
      "options": {
        "baseURL": "{env:WIPLASH_MODEL_ROUTER_BASE_URL}",
        "apiKey": "{file:~/.config/wiplash/model-router-api-key}"
      },
      "models": {
        "wiplash/qwen35b": {
          "name": "Qwen3.6 35B - auto-start / auto-stop",
          "limit": {
            "context": 8192,
            "output": 512
          }
        },
        "wiplash/qwen3-8b": {
          "name": "Qwen3 8B - auto-unload",
          "limit": {
            "context": 4096,
            "output": 512
          }
        },
        "wiplash/qwen3-coder-30b": {
          "name": "Qwen3-Coder 30B-A3B - auto-unload",
          "limit": {
            "context": 4096,
            "output": 512
          }
        }
      }
    },
    "colibri-p40": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Colibri P40 (SSH tunnel)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "local-no-auth"
      },
      "models": {
        "qwen3.6-35b-a3b-colibri-i4-p40": {
          "name": "Qwen3.6 35B-A3B — Colibri / 2x P40",
          "limit": {
            "context": 8192,
            "output": 512
          }
        }
      }
    },
    "colibri-k3": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Colibri Kimi K3 (SSH tunnel; storage-gated)",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1",
        "apiKey": "local-no-auth"
      },
      "models": {
        "kimi-k3-colibri": {
          "name": "Kimi K3 — Colibri / Vulkan P40",
          "limit": {
            "context": 8192,
            "output": 512
          }
        }
      }
    },
    "ollama-p40": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama P40 (SSH tunnel)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "local-no-auth"
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B — Ollama / P40",
          "limit": {
            "context": 4096,
            "output": 512
          }
        },
        "qwen3-coder-normal-30b-16k:latest": {
          "name": "Qwen3-Coder 30B-A3B — Ollama / P40",
          "limit": {
            "context": 4096,
            "output": 512
          }
        }
      }
    }
  }
}
