# Copy only after every requirement in docs/LOCAL_MODEL_RUNBOOK.md is met.
# This is intentionally a template, not an installed or enabled unit.
[Unit]
Description=Colibri Kimi K3 local OpenAI-compatible API (Vulkan P40)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jordanculver
Group=jordanculver
WorkingDirectory=/opt/colibri-kimi-k3
EnvironmentFile=/etc/colibri/kimi-k3.env
ExecStartPre=/usr/bin/test -x /opt/colibri-kimi-k3/c/kimi_k3
ExecStartPre=/usr/bin/test -f ${K3_MODEL_DIR}/config.json
ExecStart=/usr/bin/python3 /opt/colibri-qwen36-t24/colibri-thermal-supervisor.py /opt/colibri-kimi-k3/c/coli serve --model ${K3_MODEL_DIR} --host 127.0.0.1 --port 8001 --model-id kimi-k3-colibri --ctx 8192 --ngen 512 --kv-slots 1 --max-queue 1 --queue-timeout 300
Restart=on-failure
RestartSec=30
TimeoutStartSec=infinity
TimeoutStopSec=60
KillMode=control-group
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
