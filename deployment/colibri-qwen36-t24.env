# Exact-Q8 configuration accepted in the real-Qwen T24 control.
# Loopback only; API authentication is intentionally omitted because the unit
# never exposes a non-loopback listener.
COLI_DENSE_I8=1
COLI_CUDA=1
COLI_GPUS=0,1
CUDA_DENSE=1
CUDA_EXPERT_GB=auto
COLI_CUDA_DN_CPUORDER=1
COLI_CUDA_DN_PAIR=1
COLI_CUDA_DN_DEVICE=0
COLI_CUDA_LMHEAD_CPUORDER=1
COLI_CUDA_ATTN_CPUORDER=1
COLI_CUDA_SHARED_CPUORDER=1
OMP_NUM_THREADS=24
OMP_DYNAMIC=FALSE
OMP_WAIT_POLICY=PASSIVE
OMP_PROC_BIND=close
OMP_PLACES=cores
PILOT=0
HOT=0
COLIBRI_RESIDENT=0
COLI_MAX_CONNECTIONS=32
COLIBRI_THERMAL_C=70
COLIBRI_THERMAL_POLL_SECONDS=5
COLIBRI_THERMAL_STOP_SECONDS=45
