# Copy to /etc/colibri/kimi-k3.env only after the full model is present.
# Keep the service loopback-only. Reach it through SSH forwarding, not a LAN bind.
K3_MODEL_DIR=/mnt/ai-ssd/kimi-k3/snapshot
RAM_GB=400
K3_MAXT=8192
K3_EXPERT_GB=8
K3_VK=1
K3_VK_GB=20
K3_VK_UP=auto
K3_DIRECT=1
K3_PIPE=1
K3_IDOT=1
COLIBRI_THERMAL_C=70
COLIBRI_THERMAL_POLL_SECONDS=5
COLIBRI_THERMAL_STOP_SECONDS=45
