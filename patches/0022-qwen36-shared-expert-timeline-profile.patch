+extern "C" int p40_qwen_dn_timeline_begin(void) {
+  if (!select_context() || context.timeline_active) return 0;
+  if (!context.timeline_start &&
+      !cuda_ok(cudaEventCreate(&context.timeline_start), "timeline start event creation")) return 0;
+  if (!context.timeline_end &&
+      !cuda_ok(cudaEventCreate(&context.timeline_end), "timeline end event creation")) return 0;
+  if (!cuda_ok(cudaEventRecord(context.timeline_start, context.stream), "timeline start event record")) return 0;
+  context.timeline_active = 1;
+  return 1;
+}
+
+extern "C" int p40_qwen_dn_timeline_end(void **start_event, void **end_event) {
+  if (!start_event || !end_event || !select_context() || !context.timeline_active) return 0;
+  context.timeline_active = 0;
+  if (!cuda_ok(cudaEventRecord(context.timeline_end, context.stream), "timeline end event record")) return 0;
+  *start_event = context.timeline_start;
+  *end_event = context.timeline_end;
+  return 1;
+}
