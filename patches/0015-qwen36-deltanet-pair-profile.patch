+bool pair_profile_requested(void) {
+  const char *value = std::getenv("COLI_DN_PAIR_PROFILE");
+  return value && std::strcmp(value, "1") == 0;
+}
+
+void destroy_pair_profile_events(void) {
+  if (context.pair_begin) cudaEventDestroy(context.pair_begin);
+  if (context.pair_after_h2d) cudaEventDestroy(context.pair_after_h2d);
+  if (context.pair_after_qkv) cudaEventDestroy(context.pair_after_qkv);
+  if (context.pair_after_z) cudaEventDestroy(context.pair_after_z);
+  if (context.pair_after_d2h) cudaEventDestroy(context.pair_after_d2h);
+  context.pair_begin = nullptr;
+  context.pair_after_h2d = nullptr;
+  context.pair_after_qkv = nullptr;
+  context.pair_after_z = nullptr;
+  context.pair_after_d2h = nullptr;
+}
+
+bool init_pair_profile_events(void) {
+  if (!pair_profile_requested()) return true;
+  if (!cuda_ok(cudaEventCreate(&context.pair_begin), "pair-profile begin event") ||
+      !cuda_ok(cudaEventCreate(&context.pair_after_h2d), "pair-profile h2d event") ||
+      !cuda_ok(cudaEventCreate(&context.pair_after_qkv), "pair-profile qkv event") ||
+      !cuda_ok(cudaEventCreate(&context.pair_after_z), "pair-profile z event") ||
+      !cuda_ok(cudaEventCreate(&context.pair_after_d2h), "pair-profile d2h event")) {
+    destroy_pair_profile_events();
+    std::fprintf(stderr, "[dn-pair-gpu] profile disabled: CUDA event allocation failed\n");
+    return true;
+  }
+  context.pair_profile = true;
+  return true;
+}
+
+void disable_pair_profile(const char *operation) {
+  std::fprintf(stderr, "[dn-pair-gpu] profile disabled: %s: %s\n", operation,
+               cudaGetErrorString(cudaGetLastError()));
+  context.pair_profile = false;
+  context.pair_profile_pending = false;
+}
+
+bool record_pair_event(cudaEvent_t event, const char *operation) {
+  if (!context.pair_profile_pending) return false;
+  if (cudaEventRecord(event, context.stream) == cudaSuccess) return true;
+  disable_pair_profile(operation);
+  return false;
+}
