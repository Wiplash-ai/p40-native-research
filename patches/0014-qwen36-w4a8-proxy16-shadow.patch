+    int c=blockIdx.z,s=blockIdx.y,warp=threadIdx.x>>5,lane=threadIdx.x&31,o=blockIdx.x*8+warp;GroupDesc d=desc[c];if(s>=d.rows||o>=I)return;int r=d.offset+s;
+    if(!lane){const uint8_t *gr=(const uint8_t*)d.g+(size_t)o*((D+1)/2),*ur=(const uint8_t*)d.u+(size_t)o*((D+1)/2);float g=gate[(size_t)r*I+o],u=up[(size_t)r*I+o];for(int k=0;k<DP8_PROXY_TOPK;k++){int i=index[(size_t)r*DP8_PROXY_TOPK+k];float e=residual[(size_t)r*DP8_PROXY_TOPK+k];g+=e*dp8_s4_at(gr,i)*d.gs[o];u+=e*dp8_s4_at(ur,i)*d.us[o];}gate[(size_t)r*I+o]=dp8_silu(g)*u;}
+}
