+__global__ static void dp8_select_proxy16(const float *score,const float *x,const int8_t *q,const float *sc,
+        int *index,float *residual,int rows,int width){
+    int r=blockIdx.x;if(r>=rows||threadIdx.x)return;float best[DP8_PROXY_TOPK];int where[DP8_PROXY_TOPK];
+    for(int k=0;k<DP8_PROXY_TOPK;k++){best[k]=-1.f;where[k]=0;}int ng=(width+DP8_GROUPWISE_WIDTH-1)/DP8_GROUPWISE_WIDTH;
+    for(int i=0;i<width;i++){float v=score[(size_t)r*width+i];int p=DP8_PROXY_TOPK;for(int k=0;k<DP8_PROXY_TOPK;k++)if(v>best[k]||(v==best[k]&&i<where[k])){p=k;break;}if(p<DP8_PROXY_TOPK){for(int k=DP8_PROXY_TOPK-1;k>p;k--){best[k]=best[k-1];where[k]=where[k-1];}best[p]=v;where[p]=i;}}
+    for(int k=0;k<DP8_PROXY_TOPK;k++){int i=where[k];index[(size_t)r*DP8_PROXY_TOPK+k]=i;residual[(size_t)r*DP8_PROXY_TOPK+k]=x[(size_t)r*width+i]-(float)q[(size_t)r*width+i]*sc[(size_t)r*ng+i/DP8_GROUPWISE_WIDTH];}
+}
