+/* T34 is an exact-output shadow only.  It evaluates the T33 held-out
+ * down-norm Jacobian proxy, rather than another residual-magnitude variant:
+ *
+ * |e_c| sqrt(sum_i ||W_down[:,i]||^2
+ *   (u_i silu'(g_i) W_gate[i,c] + silu(g_i) W_up[i,c])^2).
+ *
+ * Raw gate/up are the groupwise-Q8 W4/DP4A result.  We correct the fixed 16
+ * selected input residuals in FP32 before the exact W4 down projection.  The
+ * canonical exact path is launched afterwards and remains the only return. */
+#define DP8_PROXY_TOPK 16
+__device__ static __forceinline__ float dp8_silu(float x){return x/(1.f+expf(-x));}
+__device__ static __forceinline__ float dp8_dsilu(float x){float s=1.f/(1.f+expf(-x));return s+x*s*(1.f-s);}
+
+__global__ static void grouped_gateup_w4a8_groupwise_raw(float *gate,float *up,const int8_t *q,
+        const float *sc,const GroupDesc *desc,int I,int D){
+    int c=blockIdx.z,s=blockIdx.y,warp=threadIdx.x>>5,lane=threadIdx.x&31,o=blockIdx.x*8+warp;
+    GroupDesc d=desc[c];if(s>=d.rows||o>=I)return;int r=d.offset+s;
+    const uint8_t *gr=(const uint8_t*)d.g+(size_t)o*((D+1)/2),*ur=(const uint8_t*)d.u+(size_t)o*((D+1)/2);
+    const int8_t *x=q+(size_t)r*D;int ng=(D+DP8_GROUPWISE_WIDTH-1)/DP8_GROUPWISE_WIDTH;float g=0,u=0;
+    for(int group=0;group<ng;group++){
+        int ga=0,ua=0,begin=group*DP8_GROUPWISE_WIDTH,end=min(D,begin+DP8_GROUPWISE_WIDTH);
+        for(int i=begin+lane*4;i+3<end;i+=128){uint16_t gp=(uint16_t)gr[i/2]|((uint16_t)gr[i/2+1]<<8);uint16_t pp=(uint16_t)ur[i/2]|((uint16_t)ur[i/2+1]<<8);int xv=*reinterpret_cast<const int*>(x+i);ga=__dp4a(xv,dp8_w4x4(gp),ga);ua=__dp4a(xv,dp8_w4x4(pp),ua);}
+        for(int n=16;n;n>>=1){ga+=__shfl_down_sync(0xffffffff,ga,n);ua+=__shfl_down_sync(0xffffffff,ua,n);}
+        if(!lane){float a=sc[(size_t)r*ng+group];g+=(float)ga*a*d.gs[o];u+=(float)ua*a*d.us[o];}
+    }
+    if(!lane){gate[(size_t)r*I+o]=g;up[(size_t)r*I+o]=u;}
+}
+
+__global__ static void dp8_downnorm_w4(float *norm,const GroupDesc *desc,int I,int D){
+    int i=blockIdx.x,c=blockIdx.y;if(i>=I)return;GroupDesc d=desc[c];float a=0;
+    for(int o=threadIdx.x;o<D;o+=blockDim.x){const uint8_t *w=(const uint8_t*)d.d+(size_t)o*((I+1)/2);float z=dp8_s4_at(w,i)*d.ds[o];a+=z*z;}
+    __shared__ float part[256];part[threadIdx.x]=a;__syncthreads();
+    for(int n=128;n;n>>=1){if(threadIdx.x<n)part[threadIdx.x]+=part[threadIdx.x+n];__syncthreads();}
+    if(!threadIdx.x)norm[(size_t)c*I+i]=sqrtf(part[0]);
+}
+
+__global__ static void dp8_proxy_scores(float *score,const float *x,const int8_t *q,const float *sc,
+        const float *gate,const float *up,const float *norm,const GroupDesc *desc,int I,int D){
+    int c=blockIdx.z,s=blockIdx.y,i=blockIdx.x*blockDim.x+threadIdx.x;GroupDesc d=desc[c];if(s>=d.rows||i>=D)return;int r=d.offset+s;
+    int ng=(D+DP8_GROUPWISE_WIDTH-1)/DP8_GROUPWISE_WIDTH;float residual=x[(size_t)r*D+i]-(float)q[(size_t)r*D+i]*sc[(size_t)r*ng+i/DP8_GROUPWISE_WIDTH],v=0;
+    for(int o=0;o<I;o++){
+        const uint8_t *gr=(const uint8_t*)d.g+(size_t)o*((D+1)/2),*ur=(const uint8_t*)d.u+(size_t)o*((D+1)/2);
+        float j=up[(size_t)r*I+o]*dp8_dsilu(gate[(size_t)r*I+o])*dp8_s4_at(gr,i)*d.gs[o]+dp8_silu(gate[(size_t)r*I+o])*dp8_s4_at(ur,i)*d.us[o];
+        float z=norm[(size_t)c*I+o];v+=(z*j)*(z*j);
+    }
+    score[(size_t)r*D+i]=fabsf(residual)*sqrtf(v);
+}
