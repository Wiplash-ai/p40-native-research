+/* QKV and Z have the same hidden input in a DeltaNet block. Keep their
+ * unchanged exact-Q8 kernels in the dedicated stream until the caller has
+ * completed independent CPU B/A work, then copy both results back together.
+ * This is deliberately a single pending pair: it cannot reorder dependent
+ * recurrent state or share buffers with another projection. */
+extern "C" int p40_qwen_dn_pair_issue(P40QwenDnTensor *first,
+                                       P40QwenDnTensor *second,
+                                       const float *input) {
+  if (!first || !second || !input || context.pair_first || context.pair_second ||
+      first->input != second->input || !select_context()) return 0;
+  const size_t input_bytes = static_cast<size_t>(first->input) * sizeof(float);
+  const size_t first_bytes = static_cast<size_t>(first->output) * sizeof(float);
+  const size_t second_bytes = static_cast<size_t>(second->output) * sizeof(float);
+  if (!reserve(&context.input, &context.input_capacity, input_bytes) ||
+      !reserve(&context.output, &context.output_capacity, first_bytes) ||
+      !reserve(&context.pair_output, &context.pair_output_capacity, second_bytes) ||
+      !cuda_ok(cudaMemcpyAsync(context.input, input, input_bytes,
+                               cudaMemcpyHostToDevice, context.stream),
+               "pair input upload")) return 0;
+  qwen_dn_cpuorder_q8_matvec<<<first->output, 32, 0, context.stream>>>(
+      context.output, context.input, first->weights, first->scales, first->input);
+  qwen_dn_cpuorder_q8_matvec<<<second->output, 32, 0, context.stream>>>(
+      context.pair_output, context.input, second->weights, second->scales,
+      second->input);
+  if (!cuda_ok(cudaGetLastError(), "pair kernel launch")) return 0;
+  context.pair_first = first;
+  context.pair_second = second;
+  return 1;
+}
+
+extern "C" int p40_qwen_dn_pair_take(float *first_output,
+                                      float *second_output) {
+  if (!first_output || !second_output || !context.pair_first ||
+      !context.pair_second || !select_context()) return 0;
+  P40QwenDnTensor *first = context.pair_first;
+  P40QwenDnTensor *second = context.pair_second;
+  const size_t first_bytes = static_cast<size_t>(first->output) * sizeof(float);
+  const size_t second_bytes = static_cast<size_t>(second->output) * sizeof(float);
+  const int ok =
+      cuda_ok(cudaMemcpyAsync(first_output, context.output, first_bytes,
+                              cudaMemcpyDeviceToHost, context.stream),
+              "pair first download") &&
+      cuda_ok(cudaMemcpyAsync(second_output, context.pair_output, second_bytes,
+                              cudaMemcpyDeviceToHost, context.stream),
+              "pair second download") &&
+      cuda_ok(cudaStreamSynchronize(context.stream), "pair synchronization");
+  context.pair_first = nullptr;
+  context.pair_second = nullptr;
+  return ok;
+}
+
