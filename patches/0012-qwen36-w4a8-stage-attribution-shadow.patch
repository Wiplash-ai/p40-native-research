+    std::fprintf(stderr,"[%s] rows=%d width=%d rel_l2=%.8g max_abs=%.8g cosine=%.8g finite=%d\n",tag,ctx->dp8_shadow_rows,ctx->dp8_shadow_width,sqrt(se/(sr>1e-30?sr:1e-30)),ma,dot/(sqrt(sa*sb)>1e-30?sqrt(sa*sb):1e-30),finite);
