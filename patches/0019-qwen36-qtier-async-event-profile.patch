+
+static int qtier_profile_events(DeviceContext *ctx) {
+    if (ctx->group_ev_ok) return 1;
+    for (int i = 0; i < 4; ++i) {
+        if (cudaEventCreate(&ctx->group_ev[i]) != cudaSuccess) {
+            for (int j = 0; j < i; ++j) cudaEventDestroy(ctx->group_ev[j]);
+            std::memset(ctx->group_ev, 0, sizeof(ctx->group_ev));
+            std::fprintf(stderr, "[qtier-profile] unable to create CUDA events on device %d\n", ctx->device);
+            return 0;
+        }
+    }
+    ctx->group_ev_ok = 1;
+    return 1;
+}
+
+static int qtier_profile_record(cudaEvent_t event, cudaStream_t stream, int device, const char *phase) {
+    cudaError_t status = cudaEventRecord(event, stream);
+    if (status == cudaSuccess) return 1;
+    std::fprintf(stderr, "[qtier-profile] event record (%s) failed on device %d: %s\n",
+                 phase, device, cudaGetErrorString(status));
+    return 0;
+}
