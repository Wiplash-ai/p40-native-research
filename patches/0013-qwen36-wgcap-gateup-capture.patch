+static int wgcap_enabled(void){const char *v=getenv("COLI_W4_CAPTURE");return v&&!strcmp(v,"gateup-r1");}
+static int wgcap_target(int layer,int step){return step>=0&&step<4&&(layer==0||layer==20||layer==39);}
+static size_t wgcap_matrix_bytes(int rows,int columns){return (size_t)rows*(size_t)(columns/2);}
+static size_t wgcap_record_bytes(int D,int I){
+    size_t groups=(size_t)(D+WGCAP_GROUP-1)/WGCAP_GROUP;
+    return WGCAP_RECORD_HEADER_BYTES+(size_t)(2*D+3*I)*sizeof(float)+(size_t)D+
