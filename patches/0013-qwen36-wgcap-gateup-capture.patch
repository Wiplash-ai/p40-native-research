+static int wgcap_open(void){
+    if(g_wgcap_file)return 1;
+    const char *path=getenv("COLI_W4_CAPTURE_FILE");
+    if(!path||!*path||strlen(path)>=sizeof g_wgcap_path){g_wgcap_errors++;fprintf(stderr,"[wgcap] invalid capture path\n");return 0;}
+    g_wgcap_file=fopen(path,"wb");if(!g_wgcap_file){g_wgcap_errors++;fprintf(stderr,"[wgcap] open failed: %s\n",path);return 0;}
+    memcpy(g_wgcap_path,path,strlen(path)+1);
+    const unsigned char magic[8]={'W','G','C','A','P','0','1',0};
+    uint32_t header[14]={WGCAP_VERSION,WGCAP_HEADER_BYTES,0x01020304u,WGCAP_HIDDEN,WGCAP_INTER,
+        WGCAP_GROUP,(uint32_t)wgcap_record_bytes(WGCAP_HIDDEN,WGCAP_INTER),WGCAP_RECORDS,
+        40u,3u,4u,1u,0u,0u};
+    if(!wgcap_put(magic,sizeof magic)||!wgcap_put(header,sizeof header)){fclose(g_wgcap_file);g_wgcap_file=nullptr;return 0;}
+    return 1;
+}
