+/* Qwen decode uses issue/take rather than expert_group_impl, so the latter's
+ * temporary profile events cannot account for the work that is actually
+ * asynchronous here. Each context permits only one outstanding group. */
+static int async_group_profile_prepare(DeviceContext *ctx) {
+    const char *value = std::getenv("COLI_CUDA_PROFILE");
+    if (!value || !std::atoi(value)) return 0;
+    if (ctx->group_profile_ready) return 1;
+    for (int i = 0; i < 4; ++i) {
+        if (!cuda_ok(cudaEventCreate(&ctx->group_profile_ev[i]), "async profile event")) {
+            for (int j = 0; j < i; ++j) cudaEventDestroy(ctx->group_profile_ev[j]);
+            ctx->group_profile_ready = 0;
+            return 0;
+        }
+    }
+    ctx->group_profile_ready = 1;
+    return 1;
+}
+
+static void async_group_profile_add(DeviceContext *ctx) {
+    float h2d = 0, kernel = 0, d2h = 0;
+    if (!cuda_ok(cudaEventElapsedTime(&h2d, ctx->group_profile_ev[0], ctx->group_profile_ev[1]), "async profile H2D") ||
+        !cuda_ok(cudaEventElapsedTime(&kernel, ctx->group_profile_ev[1], ctx->group_profile_ev[2]), "async profile kernel") ||
+        !cuda_ok(cudaEventElapsedTime(&d2h, ctx->group_profile_ev[2], ctx->group_profile_ev[3]), "async profile D2H")) return;
+    std::lock_guard<std::mutex> lock(g_group_stats_mu);
+    int index = (int)(ctx - g_ctx);
+    g_group_h2d_ms += h2d; g_group_kernel_ms += kernel; g_group_d2h_ms += d2h;
+    g_device_group_h2d_ms[index] += h2d; g_device_group_kernel_ms[index] += kernel;
+    g_device_group_d2h_ms[index] += d2h;
+}
+
