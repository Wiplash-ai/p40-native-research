+/* Pascal shadow control: packed per-row W4 with signed Q8 activations.  This
+ * path is deliberately used only by COLI_CUDA_W4A8_DP4A=shadow: its result is
+ * measured but never returned to Qwen. */
+__device__ static __forceinline__ int dp8_w4x4(uint16_t p){
+    int a=(int)(p&15),b=(int)((p>>4)&15),c=(int)((p>>8)&15),d=(int)((p>>12)&15);
+    a=(a&8?a-16:a)&255;b=(b&8?b-16:b)&255;c=(c&8?c-16:c)&255;d=(d&8?d-16:d)&255;
+    return a|(b<<8)|(c<<16)|(d<<24);
+}
+__global__ static void dp8_quant_rows(int8_t *q,float *sc,const float *x,int rows,int width){
+    int r=blockIdx.x;if(r>=rows)return;__shared__ float p[8];float m=0;
+    const float *src=x+(size_t)r*width;for(int i=threadIdx.x;i<width;i+=blockDim.x)m=fmaxf(m,fabsf(src[i]));
+    for(int n=16;n;n>>=1)m=fmaxf(m,__shfl_down_sync(0xffffffff,m,n));
+    if(!(threadIdx.x&31))p[threadIdx.x>>5]=m;__syncthreads();
+    if(threadIdx.x<32){m=threadIdx.x<8?p[threadIdx.x]:0;for(int n=16;n;n>>=1)m=fmaxf(m,__shfl_down_sync(0xffffffff,m,n));if(!threadIdx.x)sc[r]=m>0?m/127.f:1.f;}__syncthreads();
+    float inv=1.f/sc[r];int8_t *dst=q+(size_t)r*width;for(int i=threadIdx.x;i<width;i+=blockDim.x){int v=__float2int_rn(src[i]*inv);dst[i]=(int8_t)max(-127,min(127,v));}
+}
+__global__ static void grouped_hidden_w4a8_shadow(float *gate,const int8_t *q,const float *sc,
+        const GroupDesc *desc,int I,int D){
+    int c=blockIdx.z,s=blockIdx.y,warp=threadIdx.x>>5,lane=threadIdx.x&31,o=blockIdx.x*8+warp;
+    GroupDesc d=desc[c];if(s>=d.rows||o>=I)return;int r=d.offset+s;
+    const uint8_t *gr=(const uint8_t*)d.g+(size_t)o*((D+1)/2),*ur=(const uint8_t*)d.u+(size_t)o*((D+1)/2);
+    const int8_t *x=q+(size_t)r*D;int ga=0,ua=0;
+#pragma unroll
+    for(int i=lane*4;i<D;i+=128){uint16_t gp=(uint16_t)gr[i/2]|((uint16_t)gr[i/2+1]<<8);uint16_t up=(uint16_t)ur[i/2]|((uint16_t)ur[i/2+1]<<8);int xv=*reinterpret_cast<const int*>(x+i);ga=__dp4a(xv,dp8_w4x4(gp),ga);ua=__dp4a(xv,dp8_w4x4(up),ua);}
+    for(int n=16;n;n>>=1){ga+=__shfl_down_sync(0xffffffff,ga,n);ua+=__shfl_down_sync(0xffffffff,ua,n);}if(!lane){float g=(float)ga*sc[r]*d.gs[o],u=(float)ua*sc[r]*d.us[o];gate[(size_t)r*I+o]=(g/(1.f+expf(-g)))*u;}
+}
+__global__ static void grouped_down_w4a8_shadow(float *y,const int8_t *q,const float *sc,
+        const GroupDesc *desc,int D,int I){
+    int c=blockIdx.z,s=blockIdx.y,warp=threadIdx.x>>5,lane=threadIdx.x&31,o=blockIdx.x*8+warp;
+    GroupDesc d=desc[c];if(s>=d.rows||o>=D)return;int r=d.offset+s;const uint8_t *w=(const uint8_t*)d.d+(size_t)o*((I+1)/2);const int8_t *x=q+(size_t)r*I;int a=0;
+#pragma unroll
+    for(int i=lane*4;i<I;i+=128){uint16_t p=(uint16_t)w[i/2]|((uint16_t)w[i/2+1]<<8);a=__dp4a(*reinterpret_cast<const int*>(x+i),dp8_w4x4(p),a);}for(int n=16;n;n>>=1)a+=__shfl_down_sync(0xffffffff,a,n);if(!lane)y[(size_t)r*D+o]=(float)a*sc[r]*d.ds[o];
+}
+static int dp8_shadow_launch(DeviceContext *ctx,GroupDesc *dev,int total,int D,int I,int max_rows,int count){
+    size_t xb=(size_t)total*D*sizeof(float),qb=(size_t)total*(D>I?D:I);
+    if(!reserve(&ctx->dp8_y,&ctx->dp8_y_cap,xb)||!reserve_bytes((void**)&ctx->dp8_q,&ctx->dp8_q_cap,qb)||!reserve(&ctx->dp8_scale,&ctx->dp8_scale_cap,(size_t)total*sizeof(float))||!reserve_pinned(&ctx->host_dp8_y,&ctx->host_dp8_y_cap,xb))return 0;
+    dp8_quant_rows<<<total,256,0,ctx->stream>>>(ctx->dp8_q,ctx->dp8_scale,ctx->x,total,D);
+    grouped_hidden_w4a8_shadow<<<dim3((I+7)/8,max_rows,count),256,0,ctx->stream>>>(ctx->gate,ctx->dp8_q,ctx->dp8_scale,dev,I,D);
+    dp8_quant_rows<<<total,256,0,ctx->stream>>>(ctx->dp8_q,ctx->dp8_scale,ctx->gate,total,I);
+    grouped_down_w4a8_shadow<<<dim3((D+7)/8,max_rows,count),256,0,ctx->stream>>>(ctx->dp8_y,ctx->dp8_q,ctx->dp8_scale,dev,D,I);
+    if(!cuda_ok(cudaGetLastError(),"W4A8 DP4A shadow launch")||!cuda_ok(cudaMemcpyAsync(ctx->host_dp8_y,ctx->dp8_y,xb,cudaMemcpyDeviceToHost,ctx->stream),"W4A8 DP4A shadow download"))return 0;
+    ctx->dp8_shadow_pending=1;ctx->dp8_shadow_rows=total;ctx->dp8_shadow_width=D;return 1;
+}
