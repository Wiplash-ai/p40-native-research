+
+bool ensure_out_profile_events(void) {
+  if (context.out_begin) return true;
+  if (!cuda_ok(cudaEventCreate(&context.out_begin), "out-profile begin event") ||
+      !cuda_ok(cudaEventCreate(&context.out_after_h2d), "out-profile h2d event") ||
+      !cuda_ok(cudaEventCreate(&context.out_after_kernel), "out-profile kernel event") ||
+      !cuda_ok(cudaEventCreate(&context.out_after_d2h), "out-profile d2h event")) {
+    destroy_out_profile_events();
+    std::fprintf(stderr, "[dn-out-gpu] profile disabled: CUDA event allocation failed\n");
+    return false;
+  }
+  return true;
+}
