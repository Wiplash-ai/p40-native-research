+void destroy_out_profile_events(void) {
+  if (context.out_begin) cudaEventDestroy(context.out_begin);
+  if (context.out_after_h2d) cudaEventDestroy(context.out_after_h2d);
+  if (context.out_after_kernel) cudaEventDestroy(context.out_after_kernel);
