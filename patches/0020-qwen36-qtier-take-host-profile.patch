+static int take_profile_on(void){
+    const char *e=getenv("COLI_QTIER_TAKE_PROFILE");
+    return e && *e=='1';
+}
+static double take_profile_now_ms(void){
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC,&ts);
+    return (double)ts.tv_sec*1e3+(double)ts.tv_nsec/1e6;
+}
 
