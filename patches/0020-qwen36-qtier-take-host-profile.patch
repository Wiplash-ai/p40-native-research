 void qt_take(uint32_t mask,const float *val,int K,float *out){
     (void)K;
     if(!G.on) return;
+    int profile=take_profile_on();
     if(mask) for(int di=0;di<G.ndev;di++){
         int c=G.is_cnt[di];
         if(!c) continue;
+        double t0=profile?take_profile_now_ms():0.0;
         const float *y=coli_cuda_expert_group_take(G.dev[di]);
+        double t1=profile?take_profile_now_ms():0.0;
         if(!y) continue;
         for(int j=0;j<c;j++){
             float w=val[G.is_k[di][j]];
             const float *row=y+(size_t)j*G.D;
             for(int d=0;d<G.D;d++) out[d]+=w*row[d];
         }
+        if(profile){
+            G.take_calls[di]++;
+            G.take_wait_ms[di]+=t1-t0;
+            G.take_acc_ms[di]+=take_profile_now_ms()-t1;
+        }
         G.is_cnt[di]=0;
     }
