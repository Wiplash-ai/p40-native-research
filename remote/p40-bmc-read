#!/bin/sh
# Root-owned, fixed-operation BMC reader sharing the fan-controller lock.
set -eu

case "${1:-}" in
  sensor)
    set -- sensor
    ;;
  sel)
    set -- sel elist
    ;;
  *)
    echo "usage: p40-bmc-read sensor|sel" >&2
    exit 2
    ;;
esac

exec /usr/bin/flock -w 15 /run/wiplash-gpu-fan-guard.lock /usr/bin/ipmitool "$@"
