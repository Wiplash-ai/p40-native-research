#!/usr/bin/env bash
set -euo pipefail

server="${WIPLASH_P40_HOST:-jordanculver@192.168.1.194}"
ssh -o ExitOnForwardFailure=yes -N -L 8100:127.0.0.1:8100 "$server" &
tunnel_pid=$!
cleanup() {
  kill "$tunnel_pid" 2>/dev/null || true
  wait "$tunnel_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
export WIPLASH_MODEL_ROUTER_BASE_URL="http://127.0.0.1:8100/v1"

while ! kill -0 "$tunnel_pid" 2>/dev/null; do
  sleep 0.1
done

"$@"
